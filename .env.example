# Copie ce fichier en .env pour personnaliser (./setup_mac.sh le fait pour toi).
# Toutes les valeurs sont optionnelles : les défauts conviennent à un Mac Apple Silicon 16 Go.

# --- Dossiers ----------------------------------------------------------------------
# CLIPS_DIR=/chemin/absolu/vers/elements/YOUR DAIL CLIPS   # sortie des vidéos + assets
# WORKSPACE_DIR=/chemin/absolu/vers/backend/workspace       # fichiers de travail
# KEEP_WORKDIR=1                                            # garder les intermédiaires (debug)

# --- Vidéo -------------------------------------------------------------------------
# MAX_PROCESS_SIDE=1920   # plus grand côté du proxy de travail (et du rendu "perfect")
# MAX_SECONDS=60          # durée max importée
# MAX_FPS=60

# --- IA ----------------------------------------------------------------------------
# DEVICE=auto             # auto | mps | cuda | cpu
# DISABLE_AI=1            # forcer les moteurs classiques (sans torch)
# SAM2_MODEL=facebook/sam2.1-hiera-base-plus      # ou ...-large (meilleur, plus lent)
# SAM2_MODEL_FAST=facebook/sam2.1-hiera-small     # utilisé par le preset "rapide"
# INPAINT_MODEL=diffusers/stable-diffusion-xl-1.0-inpainting-0.1
#   (plus léger : stable-diffusion-v1-5/stable-diffusion-inpainting)

# --- ProPainter (optionnel, installé par ./setup_mac.sh --with-propainter) ------------
# PROPAINTER_DIR=/chemin/vers/third_party/ProPainter
# PROPAINTER_PYTHON=/chemin/vers/third_party/ProPainter/.venv/bin/python
# PROPAINTER_MAX_SIDE=960
